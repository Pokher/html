//Q4
function keepCharacters(str, numChars) {
    if (str.length === 0 || numChars <= 0) {
        return '';
    }
    numChars = Math.min(numChars, str.length);
    return str.substring(0, numChars);
}

const originalString = 'Robin Singh';
const numCharsToKeep = 4;

const result = keepCharacters(originalString, numCharsToKeep);
console.log(`Original string: ${originalString}`);
console.log(`Kept characters: ${result}`);


//Q5
function abbreviateName(fullName) {
    const words = fullName.split(' ');

    const abbreviatedWords = words.map((word, index) => {
        if (index === 0) {
            return word;
        } else {
            return word.charAt(0) + '.';
        }
    });
    const abbreviatedName = abbreviatedWords.join(' ');

    return abbreviatedName;
}

const fullName = 'Robin Singh';
const abbreviatedName = abbreviateName(fullName);
console.log(`${abbreviatedName}`);


//Q6
function hideEmailUsername(email) {
    const regex = /^([^@]+)@/;
    const hiddenEmail = email.replace(regex, (match, p1) => {
        const dotsNeeded = p1.length - 5;
        return p1.slice(0, 5) + '*'.repeat(dotsNeeded) + '@';
    });

    return hiddenEmail;
}
const email = 'robin_singh@example.com';
const hiddenEmail = hideEmailUsername(email);
console.log(`Hidden email: ${hiddenEmail}`);

