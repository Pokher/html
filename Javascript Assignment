function daysUntilNextChristmas() {
    const currentDate = new Date();
    const currentYear = currentDate.getFullYear();
    const currentMonth = currentDate.getMonth();
    const currentDay = currentDate.getDate();
    let nextChristmasYear = currentYear;
    let nextChristmasMonth = 11;
    let nextChristmasDay = 25;
    if (currentMonth > 11 || (currentMonth === 11 && currentDay > 25)) {
        nextChristmasYear++;
    }
    const nextChristmas = new Date(nextChristmasYear, nextChristmasMonth, nextChristmasDay);
    const differenceInMilliseconds = nextChristmas - currentDate;
    const daysLeft = Math.ceil(differenceInMilliseconds / (1000 * 60 * 60 * 24));

    return daysLeft;
}
const daysLeft = daysUntilNextChristmas();
console.log(`There are ${daysLeft} days left until the next Christmas.`);

