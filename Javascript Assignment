function findSundayJanuaryFirst(startYear, endYear) {
    const sundays = [];
    for (let year = startYear; year <= endYear; year++) {
        const date = new Date(year, 0, 1);
        if (date.getDay() === 0) {
            sundays.push(year);
        }
    }
    return sundays;
}

const startYear = 2014;
const endYear = 2050;
const sundayJanuaryFirstYears = findSundayJanuaryFirst(startYear, endYear);
console.log(`January 1st is a Sunday in the following years between ${startYear} and ${endYear}:`);
console.log(sundayJanuaryFirstYears.join(', '));

