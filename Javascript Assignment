function isLeapYear(year) {
    if (year % 4 !== 0) {
        return false;
    }
    if (year % 100 !== 0) {
        return true;
    }
    return year % 400 === 0;
}
const year = 2021;
const leapYear = isLeapYear(year);
console.log(`The year ${year} is ${leapYear ? 'a' : 'not a'} leap year.`);

