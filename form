<html>
    <head>
        <h1 align="center">ENTRY FORM</h1><br><br><br>
    </head>
    <body bgcolor="LightSkyBlue">
        <form>
            <label for="fname">Enter your Name: </label>
            <input type="text" id="fname" name="fname"><br><br>
            <label for="age">Enter your Age:</label>
            <input type="number" id="age" name="age"><br><br>
            <p><label for="address">Enter your Address: </label></p>
            <textarea id="address" name="address" rows="4" cols="30"></textarea><br><br>
            <label for="gender">Sex: </label>
            <input type="radio" id="f" name="gender" value="Female">
            <label for="f">Female</label><br>
            <input type="radio" id="m" name="gender" value="Male">
            <label for="m">Male</label><br><br>
            <label for="nationality">Nationality: </label>
                <input list="nationality">
                <datalist id="nationality">
                    <option value="Indian"></option>
                    <option value="German"></option>
                    <option value="Italian"></option>
                    <option value="Mexican"></option>
                </datalist>               
            <br><br>
            <label for="language">Languages Known: </label>
            <input type="checkbox" id="l1" name="l1" value="C">
            <label for="l1">C</label><br>
            <input type="checkbox" id="l2" name="l2" value="C++">
            <label for="l2">C++</label><br>
            <input type="checkbox" id="l3" name="l3" value="VB">
            <label for="l3">VB</label><br>
            <input type="checkbox" id="l4" name="l4" value="JAVA">
            <label for="l4">JAVA</label><br>
            <input type="checkbox" id="l5" name="l5" value="ASP">
            <label for="l5">ASP</label><br>
            <input type="checkbox" id="l6" name="l6" value="OTHERS">
            <label for="l6">OTHERS</label><br><br>
            <label for="password">Enter your Password: </label>
            <input type="password" id="pass" name="pass" value="">
            <br><br><br>
            <input type="button" id="reset" name="reset" value="Reset">
            <input type="button" id="submit" name="submit" value="Submit">
        </form>
    </body>
</html>
